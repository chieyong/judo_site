---
import LanguageSwitch from './LanguageSwitch.astro';
import { path, type Lang, type Alternates, type RouteKey } from '../i18n/routes';
import { useTranslations } from '../i18n/utils';
import type { UIKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);

const items: { key: RouteKey; label: UIKey }[] = [
  { key: 'start', label: 'nav.start' },
  { key: 'clubs', label: 'nav.clubs' },
  { key: 'talent', label: 'nav.talent' },
  { key: 'team', label: 'nav.team' },
  { key: 'news', label: 'nav.news' },
];

const current = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const ariaCurrent = (href: string) =>
  current === href ? 'page' : href !== path('home', lang) && current.startsWith(href) ? 'true' : undefined;
const membersHref = path('members', lang);
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href={path('home', lang)}>
      <svg class="logo-mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
        <rect width="48" height="48" rx="10" fill="var(--color-brand)" />
        <path d="M10 26h28" stroke="var(--color-accent)" stroke-width="5" stroke-linecap="round" />
        <path d="M24 26l-7 11M24 26l7 11" stroke="var(--color-accent)" stroke-width="4" stroke-linecap="round" />
        <circle cx="24" cy="14" r="4.5" fill="#fff" />
      </svg>
      <span class="logo-text">
        <span class="logo-name">Top Judo</span>
        <span class="logo-place">Lindeweerd</span>
      </span>
    </a>

    <div class="tools">
      <LanguageSwitch lang={lang} alternates={alternates} />
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        {t('nav.menu')}
      </button>
    </div>

    <nav id="site-nav" class="nav" aria-label={t('nav.label')}>
      <ul>
        {
          items.map(({ key, label }) => {
            const href = path(key, lang);
            return (
              <li>
                <a href={href} aria-current={ariaCurrent(href)}>
                  {t(label)}
                </a>
              </li>
            );
          })
        }
        <li>
          <a class="members" href={membersHref} aria-current={ariaCurrent(membersHref)}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
            </svg>
            {t('nav.members')}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Menu inklappen op mobiel. Zonder JavaScript blijft het menu gewoon zichtbaar.
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  if (header && toggle) {
    header.classList.add('has-js');
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid #e4e6ec;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-4);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-brand);
  }
  .logo-mark {
    width: 3rem;
    height: 3rem;
    flex: none;
  }
  .logo-text {
    display: grid;
    line-height: 1.05;
  }
  .logo-name {
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }
  .logo-place {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-brand-mid);
    letter-spacing: 0.02em;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .menu-toggle {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: var(--space-2) var(--space-3);
    font: inherit;
    font-weight: 600;
    background: transparent;
    color: var(--color-brand);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .nav {
    flex-basis: 100%;
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.625rem 0;
    text-decoration: none;
    color: var(--color-brand);
    font-weight: 600;
    font-size: 1rem;
  }
  .nav a:hover {
    color: var(--color-brand-mid);
  }
  .nav a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }
  .nav .members {
    padding: 0.625rem 1rem;
    border: 1.5px solid var(--color-brand);
    border-radius: var(--radius);
  }
  .nav .members:hover {
    background: var(--color-brand-tint);
  }

  /* Smal scherm: menu inklapbaar (alleen als JavaScript werkt) */
  @media (max-width: 68rem) {
    .has-js .menu-toggle {
      display: inline-flex;
    }
    .has-js .nav {
      display: none;
    }
    .has-js:has(.menu-toggle[aria-expanded='true']) .nav {
      display: block;
    }
    .nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding-bottom: var(--space-3);
    }
    .nav .members {
      margin-top: var(--space-2);
    }
  }

  /* Breed scherm: menu in één regel naast het logo */
  @media (min-width: 68.01rem) {
    .bar {
      flex-wrap: nowrap;
    }
    .nav {
      flex-basis: auto;
      order: 2;
      margin-left: auto;
    }
    .tools {
      order: 3;
    }
  }
</style>
