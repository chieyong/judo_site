---
import { langs, type Lang, type Alternates } from '../i18n/routes';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const names: Record<Lang, string> = { nl: 'Nederlands', en: 'English' };
---

<nav class="lang" aria-label={t('lang.label')}>
  {
    langs.map((l, i) => (
      <>
        {i > 0 && <span class="sep" aria-hidden="true">|</span>}
        {l === lang ? (
          <span class="current" aria-current="true">
            <abbr title={names[l]} lang={l}>{l.toUpperCase()}</abbr>
          </span>
        ) : (
          <a href={alternates[l]} hreflang={l} lang={l} title={names[l]}>
            <span aria-hidden="true">{l.toUpperCase()}</span>
            <span class="visually-hidden">{names[l]}</span>
          </a>
        )}
      </>
    ))
  }
</nav>

<style>
  .lang {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-weight: 700;
    font-size: var(--text-sm);
  }
  .lang a,
  .current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border-radius: var(--radius);
  }
  .lang a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .lang a:hover {
    color: var(--color-brand);
    background: var(--color-brand-tint);
  }
  .current {
    color: var(--color-brand);
  }
  .current abbr {
    text-decoration: none;
  }
  .sep {
    color: var(--color-border);
  }
</style>
