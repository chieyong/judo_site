---
import type { Localized } from '../i18n/utils';
import { formatDate, useTranslations } from '../i18n/utils';
import { newsPath, type Lang } from '../i18n/routes';

interface Props {
  item: Localized<'nieuws'>;
  lang: Lang;
  headingLevel?: 'h2' | 'h3';
}

const { item, lang, headingLevel: H = 'h3' } = Astro.props;
const t = useTranslations(lang);
const { title, date, image, imageAlt, summary } = item.data;
---

<article class="news-card" lang={item.isFallback ? item.contentLang : undefined}>
  {image && <img src={image} alt={imageAlt ?? ''} width="800" height="450" loading="lazy" />}
  <p class="date"><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, lang)}</time></p>
  <H class="title">
    <a href={newsPath(item.slug, lang)}>{title}</a>
  </H>
  {summary && <p class="summary">{summary}</p>}
  {item.isFallback && <p class="fallback-note" lang={lang}>{t('fallback.notice')}</p>}
</article>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    position: relative;
  }
  .news-card img {
    width: 100%;
    height: 12.5rem;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }
  .title {
    font-size: var(--text-lg);
    margin: 0;
  }
  .title a {
    text-decoration: none;
  }
  /* Hele kaart klikbaar, maar één link voor schermlezers */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .news-card:hover .title a {
    text-decoration: underline;
  }
  .news-card:has(a:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
    border-radius: var(--radius-lg);
  }
  .title a:focus-visible {
    outline: none;
  }
  .summary {
    margin: 0;
    font-size: 1rem;
    color: var(--color-text-muted);
  }
  .fallback-note {
    margin: 0;
  }
</style>
