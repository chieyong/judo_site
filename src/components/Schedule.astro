---
/**
 * Trainingsweek als rooster: groepen als rijen, dagen als kolommen.
 * Gegevens komen uit de CMS-collectie "trainingen".
 */
import { getLocalized, useTranslations, dayOrder, type Day } from '../i18n/utils';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  caption: string;
}

const { lang, caption } = Astro.props;
const t = useTranslations(lang);
const items = await getLocalized('trainingen', lang);

// Groepen in vaste volgorde: op bestandsnaam (die het CMS uit de Nederlandse groepsnaam maakt).
const groups: { label: string; fallback: boolean; byDay: Map<Day, typeof items> }[] = [];
for (const item of [...items].sort((a, b) => a.slug.localeCompare(b.slug))) {
  let group = groups.find((g) => g.label === item.data.ageGroup);
  if (!group) {
    group = { label: item.data.ageGroup, fallback: item.isFallback, byDay: new Map() };
    groups.push(group);
  }
  const list = group.byDay.get(item.data.day) ?? [];
  list.push(item);
  group.byDay.set(item.data.day, list);
}
const days = dayOrder.filter((d) => items.some((i) => i.data.day === d));
---

<div class="table-wrap" role="region" aria-label={caption} tabindex="0">
  <table>
    <caption class="visually-hidden">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">{t('schedule.ageGroup')}</th>
        {days.map((d) => <th scope="col">{t(`day.${d}`)}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        groups.map((g) => (
          <tr>
            <th scope="row" lang={g.fallback ? 'nl' : undefined}>{g.label}</th>
            {days.map((d) => {
              const sessions = g.byDay.get(d) ?? [];
              return (
                <td>
                  {sessions.length === 0 ? (
                    <span class="none" aria-label={t('schedule.none')}>–</span>
                  ) : (
                    sessions.map((s) => (
                      <span class="session">
                        <span class="time">{s.data.time}</span>
                        <span class="loc">{s.data.location}</span>
                      </span>
                    ))
                  )}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-wrap {
    overflow-x: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 40rem;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  thead th {
    border-top: 0;
    font-size: var(--text-sm);
    background: var(--color-brand-tint);
  }
  tbody th {
    font-weight: 700;
    white-space: nowrap;
  }
  .session {
    display: grid;
  }
  .session + .session {
    margin-top: var(--space-2);
  }
  .time {
    font-weight: 600;
    white-space: nowrap;
  }
  .loc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .none {
    color: var(--color-text-muted);
  }
</style>
