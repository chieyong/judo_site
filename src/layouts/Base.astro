---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { langs, defaultLang, type Lang, type Alternates } from '../i18n/routes';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Adres van deze pagina in elke taal (voor taalknop en hreflang). */
  alternates: Alternates;
}

const { lang, title, description, alternates } = Astro.props;
const t = useTranslations(lang);
const siteName = t('site.name');
const fullTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const site = Astro.site ?? new URL('http://localhost:4321');
const abs = (p: string) => new URL(p, site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={abs(alternates[lang])} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={abs(alternates[l])} />)}
    <link rel="alternate" hreflang="x-default" href={abs(alternates[defaultLang])} />
    <meta name="theme-color" content="#8b1e2d" />
    <script is:inline>
      // Uitnodigings- en wachtwoordlinks van Netlify Identity komen op de homepage uit.
      // Stuur ze door naar /admin/, zodat de beheerder daar kan inloggen.
      if (/(invite|recovery|confirmation|email_change)_token=/.test(location.hash)) {
        location.replace('/admin/' + location.hash);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Header lang={lang} alternates={alternates} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -10rem;
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    background: var(--color-text);
    color: #fff;
    border-radius: var(--radius);
    font-weight: 600;
  }
  .skip-link:focus {
    top: var(--space-4);
    color: #fff;
  }
  main:focus {
    outline: none;
  }
</style>
