---
import NewsDetail from '../../../views/NewsDetail.astro';
import { getLocalized } from '../../../i18n/utils';

export async function getStaticPaths() {
  const items = await getLocalized('nieuws', 'en');
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
---

<NewsDetail lang="en" item={item} />
