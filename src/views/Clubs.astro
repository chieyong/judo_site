---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { getLocalized, useTranslations } from '../i18n/utils';
import { path, routes, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
  nl: {
    title: 'Vind een judoclub in de buurt',
    pageTitle: 'Vind een club',
    description: 'De partnerclubs van Top Judo Lindeweerd, met filter op plaats.',
    lead: 'Judo begint altijd bij een club. Deze zes clubs werken samen met Top Judo Lindeweerd. Heeft je kind talent, dan staat de weg naar het talentprogramma open.',
    countAll: (n: number) => `${n} clubs in de regio`,
    countIn: (n: number, p: string) => (n === 1 ? `1 club in ${p}` : `${n} clubs in ${p}`),
    visit: 'van',
    startTitle: 'Zo begin je met judo',
    start: [
      { title: 'Kies een club', text: 'Dicht bij huis is het makkelijkst om vol te houden.' },
      { title: 'Doe een proefles', text: 'De meeste clubs bieden een gratis proefles. Kijk op hun website.' },
      { title: 'Word lid en groei', text: 'Wil je meer uitdaging? Dan is het talentprogramma de volgende stap.' },
    ],
    stepLabel: 'Stap',
    cta: 'Mijn kind heeft talent: zo werkt het',
  },
  en: {
    title: 'Find a judo club near you',
    pageTitle: 'Find a club',
    description: 'The partner clubs of Top Judo Lindeweerd, filterable by town.',
    lead: 'Judo always starts at a club. These six clubs work together with Top Judo Lindeweerd. If your child has talent, the way to the talent programme is open.',
    countAll: (n: number) => `${n} clubs in the region`,
    countIn: (n: number, p: string) => (n === 1 ? `1 club in ${p}` : `${n} clubs in ${p}`),
    visit: 'of',
    startTitle: 'How to start with judo',
    start: [
      { title: 'Choose a club', text: 'Close to home makes it easiest to keep going.' },
      { title: 'Try a free lesson', text: 'Most clubs offer a free trial lesson. Check their website.' },
      { title: 'Join and grow', text: 'Want more of a challenge? Then the talent programme is the next step.' },
    ],
    stepLabel: 'Step',
    cta: 'My child has talent: how it works',
  },
}[lang];

const clubs = (await getLocalized('clubs', lang)).sort(
  (a, b) => Number(b.data.cofounder) - Number(a.data.cofounder) || a.data.name.localeCompare(b.data.name),
);
const places = [...new Set(clubs.map((c) => c.data.place))].sort((a, b) => a.localeCompare(b));
// Teksten voor de teller, per plaats vooraf berekend zodat het script geen vertalingen nodig heeft
const counts: Record<string, string> = { '': copy.countAll(clubs.length) };
for (const p of places) counts[p] = copy.countIn(clubs.filter((c) => c.data.place === p).length, p);
---

<Base lang={lang} title={copy.pageTitle} description={copy.description} alternates={routes.clubs}>
  <PageHero title={copy.title} lead={copy.lead} />

  <section class="section">
    <div class="container">
      <div class="filter" data-club-filter hidden>
        <h2 id="filter-title" class="filter-title">{t('clubs.filterLabel')}</h2>
        <div class="chips" role="group" aria-labelledby="filter-title">
          <button type="button" aria-pressed="true" data-place="">{t('clubs.filterAll')}</button>
          {places.map((p) => <button type="button" aria-pressed="false" data-place={p}>{p}</button>)}
        </div>
      </div>
      <p class="count" role="status" data-club-count data-counts={JSON.stringify(counts)}>{counts['']}</p>

      <ul class="plain-list clubs">
        {
          clubs.map((club) => (
            <li class="card club" data-place={club.data.place} lang={club.isFallback ? club.contentLang : undefined}>
              <div class="meta">
                <span class="place">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" />
                    <circle cx="12" cy="10" r="2.5" />
                  </svg>
                  {club.data.place}
                </span>
                {club.data.cofounder && <span class="badge">{t('clubs.cofounder')}</span>}
              </div>
              <h3>{club.data.name}</h3>
              <p>{club.data.description}</p>
              {club.data.website && (
                <a class="site" href={club.data.website} rel="noopener">
                  {t('clubs.website')}
                  <span class="visually-hidden">
                    {' '}
                    {copy.visit} {club.data.name}
                  </span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="start-title">
    <div class="container">
      <h2 id="start-title">{copy.startTitle}</h2>
      <ol class="plain-list grid start">
        {
          copy.start.map((s, i) => (
            <li class="card">
              <p class="eyebrow">
                {copy.stepLabel} {i + 1}
              </p>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
      <a class="button button--accent" href={path('parents', lang)}>{copy.cta}</a>
    </div>
  </section>
</Base>

<script>
  // Filter op plaats. Zonder JavaScript zijn alle clubs zichtbaar en blijft het filter verborgen.
  const wrap = document.querySelector<HTMLElement>('[data-club-filter]');
  const count = document.querySelector<HTMLElement>('[data-club-count]');
  const buttons = wrap?.querySelectorAll<HTMLButtonElement>('button[data-place]');
  const cards = document.querySelectorAll<HTMLElement>('.club[data-place]');
  if (wrap && count && buttons) {
    const counts: Record<string, string> = JSON.parse(count.dataset.counts ?? '{}');
    wrap.hidden = false;
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const place = button.dataset.place ?? '';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        cards.forEach((card) => {
          card.hidden = Boolean(place) && card.dataset.place !== place;
        });
        count.textContent = counts[place] ?? '';
      });
    });
  }
</script>

<style>
  .filter[hidden] {
    display: none;
  }
  .filter-title {
    font-size: 1.125rem;
    margin-bottom: var(--space-3);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }
  .chips button {
    min-height: 2.75rem;
    padding: 0 1.125rem;
    border-radius: 999px;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    background: var(--color-surface);
    color: var(--color-brand);
    border: 1.5px solid #b7c2d6;
  }
  .chips button:hover {
    border-color: var(--color-brand);
  }
  .chips button[aria-pressed='true'] {
    background: var(--color-brand);
    color: var(--color-on-brand);
    border-color: var(--color-brand);
  }
  .count {
    margin: var(--space-5) 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .clubs {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
  .club {
    display: flex;
    flex-direction: column;
  }
  .club[hidden] {
    display: none;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .place {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-brand-mid);
  }
  .club h3 {
    margin-bottom: var(--space-2);
  }
  .site {
    margin-top: auto;
    font-weight: 600;
  }
  .start {
    margin-bottom: var(--space-6);
  }
</style>
