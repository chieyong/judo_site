---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import DemoForm from '../components/DemoForm.astro';
import { getLocalized, useTranslations } from '../i18n/utils';
import { routes, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
  nl: {
    pageTitle: 'Voor clubtrainers',
    description: 'Hoe trainers van partnerclubs talent kunnen voordragen, en wat de club terugkrijgt.',
    eyebrow: 'Voor clubtrainers en besturen',
    title: 'Jij ziet het talent als eerste. Samen laten we het groeien.',
    lead: 'We nemen je judoka’s niet over. We geven ze er iets bij. Jouw club blijft de thuisbasis, en jij blijft de trainer die het talent ontdekte.',
    ctaNominate: 'Draag een judoka voor',
    ctaBack: 'Wat krijgt mijn club terug?',
    staysTitle: 'Wat bij jouw club blijft',
    stays: [
      { title: 'Het lidmaatschap', text: 'Elke judoka in het talentprogramma blijft verplicht lid van de eigen club.' },
      { title: 'De banden', text: 'Examens en banden haal je alleen bij je eigen club.' },
      { title: 'De basis', text: 'De judoka blijft bij jou trainen. Wij komen erbij, niet ervoor in de plaats.' },
    ],
    howTitle: 'Zo draag je een talent voor',
    howIntro: 'Meldt een ouder zich zelf aan? Dan bellen we altijd eerst jou.',
    how: [
      { title: 'Herken het', text: 'Leert snel, wil winnen, vraagt om meer. Twijfel je? Stuur de judoka naar de gratis training voor onder 13 op donderdag.' },
      { title: 'Draag voor', text: 'Vul het formulier hieronder in. Wij nodigen de judoka uit voor een proeftraining.' },
      { title: 'Beslis mee', text: 'Na de proeftraining kijken de technische staf en jij samen of de stap past.' },
    ],
    backTitle: 'Wat jouw club terugkrijgt',
    backIntro: 'Een talent in het programma is reclame voor je club, geen verlies.',
    back: [
      { title: 'Je clubnaam bij elk resultaat', text: 'In onze berichten noemen we de judoka altijd met de eigen club erbij.' },
      { title: 'Een clinic op jouw club', text: 'Eén keer per jaar komen judoka’s en trainers van het talentprogramma bij je op de mat.' },
      { title: 'Bijscholing voor trainers', text: 'Train een keer mee met de technische staf en neem oefenstof mee naar je club.' },
      { title: 'Het label Partnerclub', text: 'Een badge voor je eigen website. Laat nieuwe ouders zien dat talent bij jou verder kan.' },
    ],
    backProposal: 'Nog te besluiten door het bestuur.',
    formTitle: 'Draag een judoka voor',
    formIntro: 'We nemen binnen een week contact op met jou en met de ouders.',
    fields: {
      trainer: 'Jouw naam',
      club: 'Club',
      clubChoose: 'Kies je club',
      initials: 'Voornaam of initialen judoka',
      initialsHint: 'Achternaam en geboortedatum zijn niet nodig.',
      age: 'Leeftijd',
      belt: 'Band',
      beltOptions: ['Wit', 'Geel', 'Oranje', 'Groen', 'Blauw', 'Bruin'],
      parents: 'De ouders weten van deze voordracht',
      why: 'Waarom past het talentprogramma bij deze judoka?',
    },
    submit: 'Voordracht versturen',
    contact: 'Vragen? Mail de technisch coördinator via techniek@topjudo-lindeweerd.example.',
  },
  en: {
    pageTitle: 'For club coaches',
    description: 'How coaches at partner clubs can nominate talent, and what the club gets back.',
    eyebrow: 'For club coaches and boards',
    title: 'You spot the talent first. Together we help it grow.',
    lead: 'We do not take your judoka away. We give them something extra. Your club remains home base, and you remain the coach who discovered the talent.',
    ctaNominate: 'Nominate a judoka',
    ctaBack: 'What does my club get back?',
    staysTitle: 'What stays with your club',
    stays: [
      { title: 'Membership', text: 'Every judoka in the talent programme must stay a member of their own club.' },
      { title: 'Belts', text: 'Gradings and belts are only done at your own club.' },
      { title: 'The basics', text: 'The judoka keeps training with you. We come on top, not instead.' },
    ],
    howTitle: 'How to nominate a talent',
    howIntro: 'If a parent signs up directly, we always call you first.',
    how: [
      { title: 'Spot it', text: 'Learns fast, wants to win, asks for more. Not sure? Send the judoka to the free under-13 session on Thursday.' },
      { title: 'Nominate', text: 'Fill in the form below. We invite the judoka for a trial session.' },
      { title: 'Decide together', text: 'After the trial session, the technical staff and you decide together whether the step fits.' },
    ],
    backTitle: 'What your club gets back',
    backIntro: 'A talent in the programme is an advert for your club, not a loss.',
    back: [
      { title: 'Your club name with every result', text: 'In our news we always mention the judoka together with their own club.' },
      { title: 'A clinic at your club', text: 'Once a year, judoka and coaches from the talent programme visit your mat.' },
      { title: 'Coach development', text: 'Train along with the technical staff and take exercises back to your club.' },
      { title: 'The Partner club label', text: 'A badge for your own website. Show new parents that talent can grow with you.' },
    ],
    backProposal: 'Still to be decided by the board.',
    formTitle: 'Nominate a judoka',
    formIntro: 'We will contact you and the parents within a week.',
    fields: {
      trainer: 'Your name',
      club: 'Club',
      clubChoose: 'Choose your club',
      initials: 'First name or initials of the judoka',
      initialsHint: 'No surname or date of birth needed.',
      age: 'Age',
      belt: 'Belt',
      beltOptions: ['White', 'Yellow', 'Orange', 'Green', 'Blue', 'Brown'],
      parents: 'The parents know about this nomination',
      why: 'Why does the talent programme suit this judoka?',
    },
    submit: 'Send nomination',
    contact: 'Questions? Email the technical coordinator at techniek@topjudo-lindeweerd.example.',
  },
}[lang];

const clubs = (await getLocalized('clubs', lang)).map((c) => c.data.name).sort((a, b) => a.localeCompare(b));
const f = copy.fields;
const req = t('form.required');
---

<Base lang={lang} title={copy.pageTitle} description={copy.description} alternates={routes.coaches}>
  <PageHero eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead}>
    <Fragment slot="actions">
      <a class="button button--accent" href="#voordragen">{copy.ctaNominate}</a>
      <a class="button button--on-dark" href="#terug">{copy.ctaBack}</a>
    </Fragment>
  </PageHero>

  <section class="section" aria-labelledby="stays-title">
    <div class="container">
      <h2 id="stays-title">{copy.staysTitle}</h2>
      <ul class="plain-list grid">
        {
          copy.stays.map((s) => (
            <li class="card">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="how-title">
    <div class="container">
      <div class="section-intro">
        <h2 id="how-title">{copy.howTitle}</h2>
        <p>{copy.howIntro}</p>
      </div>
      <ol class="plain-list grid">
        {
          copy.how.map((s, i) => (
            <li class="card">
              <span class:list={['step-nr', { 'step-nr--accent': i === copy.how.length - 1 }]} aria-hidden="true">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="terug" aria-labelledby="back-title">
    <div class="container">
      <div class="section-intro">
        <h2 id="back-title">{copy.backTitle}</h2>
        <p>{copy.backIntro}</p>
      </div>
      <p class="proposal-line"><span class="proposal">{t('proposal')}</span> {copy.backProposal}</p>
      <ul class="plain-list grid">
        {
          copy.back.map((b) => (
            <li class="card card--outline">
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tint" id="voordragen" aria-labelledby="form-title">
    <div class="container narrow">
      <div class="section-intro">
        <h2 id="form-title">{copy.formTitle}</h2>
        <p>{copy.formIntro}</p>
      </div>
      <div class="form-card">
        <DemoForm lang={lang} id="nominate" submitLabel={copy.submit}>
          <div class="row">
            <div class="field">
              <label for="n-trainer">{f.trainer} <span class="required" aria-hidden="true">*</span><span class="visually-hidden">({req})</span></label>
              <input id="n-trainer" name="trainer" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="n-club">{f.club} <span class="required" aria-hidden="true">*</span><span class="visually-hidden">({req})</span></label>
              <select id="n-club" name="club" required>
                <option value="">{f.clubChoose}</option>
                {clubs.map((c) => <option>{c}</option>)}
              </select>
            </div>
          </div>
          <div class="row row--3">
            <div class="field">
              <label for="n-initials">{f.initials} <span class="required" aria-hidden="true">*</span><span class="visually-hidden">({req})</span></label>
              <input id="n-initials" name="initials" type="text" autocomplete="off" aria-describedby="n-initials-hint" required />
              <span class="hint" id="n-initials-hint">{f.initialsHint}</span>
            </div>
            <div class="field">
              <label for="n-age">{f.age}</label>
              <input id="n-age" name="age" type="number" inputmode="numeric" min="5" max="21" />
            </div>
            <div class="field">
              <label for="n-belt">{f.belt}</label>
              <select id="n-belt" name="belt">
                {f.beltOptions.map((b) => <option>{b}</option>)}
              </select>
            </div>
          </div>
          <div class="field">
            <label for="n-why">{f.why}</label>
            <textarea id="n-why" name="why" rows="4"></textarea>
          </div>
          <div class="check">
            <input id="n-parents" name="parents" type="checkbox" required />
            <label for="n-parents">{f.parents} <span class="required" aria-hidden="true">*</span><span class="visually-hidden">({req})</span></label>
          </div>
        </DemoForm>
      </div>
      <p class="contact">{copy.contact}</p>
    </div>
  </section>
</Base>

<style>
  .proposal-line {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: calc(-1 * var(--space-3)) 0 var(--space-5);
  }
  .narrow {
    max-width: 49rem;
  }
  .form-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
  .row {
    display: grid;
    gap: 1.125rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .row--3 {
    grid-template-columns: 2fr 1fr 1fr;
  }
  @media (max-width: 40rem) {
    .row--3 {
      grid-template-columns: 1fr 1fr;
    }
    .row--3 > :first-child {
      grid-column: 1 / -1;
    }
  }
  .check {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }
  .check input {
    width: 1.25rem;
    height: 1.25rem;
    accent-color: var(--color-brand);
    flex: none;
  }
  .contact {
    margin: var(--space-5) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
