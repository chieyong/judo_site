---
import Base from '../layouts/Base.astro';
import MembershipCard from '../components/MembershipCard.astro';
import { getLocalized, useTranslations, dayOrder } from '../i18n/utils';
import { routes, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
  nl: {
    title: 'Leden',
    description: 'Demo van een ledenomgeving. Geen echte login.',
    banner: 'Dit is een demo. Er is geen echte login: elke naam en elk wachtwoord werkt, en er wordt niets opgeslagen of verstuurd.',
    loginTitle: 'Inloggen voor leden',
    username: 'Gebruikersnaam',
    password: 'Wachtwoord',
    login: 'Inloggen (demo)',
    noscript: 'Voor deze demo is JavaScript nodig.',
    hello: 'Hoi Sam',
    profile: 'Groep vanaf 15 · Volledig lid · Partnerclub: Judoschool De Brug',
    profileNote: 'Voorbeeldprofiel, geen echte persoon.',
    logout: 'Uitloggen',
    weekTitle: 'Jouw trainingen deze week',
    matchesTitle: 'Komende wedstrijden',
    matches: [
      { date: '29 nov', name: 'Clubtoernooi Oudeveen', note: 'Inschrijven via je trainer' },
      { date: '13 dec', name: 'Regionale ranking Kraanburg', note: 'Coach: talenttrainer' },
      { date: '17 jan', name: 'Nieuwjaarstoernooi Lindeweerd', note: 'Inschrijving opent 1 dec' },
    ],
    arrangeTitle: 'Regelen',
    arrange: ['Afmelden voor een training', 'Wijziging doorgeven', 'Trainingspak bestellen', 'Vrijwilliger worden'],
    arrangeNote: 'In deze demo doen de knoppen niets.',
    supportTitle: 'Begeleiding',
    support: [
      { title: 'Voeding', text: 'Spreekuur met de sportdiëtist, elke eerste maandag van de maand.' },
      { title: 'Vertrouwenscontactpersoon', text: 'Voor alles wat je liever niet met je trainer bespreekt.' },
    ],
    pricesTitle: 'Lidmaatschap en bijdrage',
    pricesText: 'Deze bedragen zijn alleen zichtbaar voor leden. Is de bijdrage een drempel? Vraag naar de mogelijkheden.',
    docsTitle: 'Documenten',
    docs: ['Welkomstpakket nieuwe leden', 'Gedragscode en trainingsafspraken', 'Vakantierooster 2026-2027', 'Privacyverklaring'],
    sample: '(voorbeeld)',
  },
  en: {
    title: 'Members',
    description: 'Demo of a members area. No real login.',
    banner: 'This is a demo. There is no real login: any name and password works, and nothing is stored or sent.',
    loginTitle: 'Member login',
    username: 'Username',
    password: 'Password',
    login: 'Log in (demo)',
    noscript: 'This demo requires JavaScript.',
    hello: 'Hi Sam',
    profile: 'Group 15 and over · Full member · Partner club: Judoschool De Brug',
    profileNote: 'Sample profile, not a real person.',
    logout: 'Log out',
    weekTitle: 'Your training this week',
    matchesTitle: 'Upcoming competitions',
    matches: [
      { date: '29 Nov', name: 'Club tournament Oudeveen', note: 'Register through your coach' },
      { date: '13 Dec', name: 'Regional ranking Kraanburg', note: 'Coach: talent coach' },
      { date: '17 Jan', name: 'New Year tournament Lindeweerd', note: 'Registration opens 1 Dec' },
    ],
    arrangeTitle: 'Arrange',
    arrange: ['Cancel a training session', 'Report a change', 'Order a tracksuit', 'Become a volunteer'],
    arrangeNote: 'In this demo the buttons do nothing.',
    supportTitle: 'Support',
    support: [
      { title: 'Nutrition', text: 'Drop-in with the sports dietitian, first Monday of every month.' },
      { title: 'Confidential contact', text: 'For anything you would rather not discuss with your coach.' },
    ],
    pricesTitle: 'Membership and fees',
    pricesText: 'These amounts are only visible to members. Is the fee a barrier? Ask about the options.',
    docsTitle: 'Documents',
    docs: ['Welcome pack for new members', 'Code of conduct and training agreements', 'Holiday schedule 2026-2027', 'Privacy statement'],
    sample: '(sample)',
  },
}[lang];

const memberships = (await getLocalized('lidmaatschappen', lang)).sort((a, b) => a.data.order - b.data.order);
// Voorbeeldlid zit in de oudste groep: trainingen waarvan de bestandsnaam met "vanaf-15" begint
const week = (await getLocalized('trainingen', lang))
  .filter((s) => s.slug.startsWith('vanaf-15'))
  .sort((a, b) => dayOrder.indexOf(a.data.day) - dayOrder.indexOf(b.data.day));
---

<Base lang={lang} title={copy.title} description={copy.description} alternates={routes.members}>
  <section class="top">
    <div class="container">
      <p class="demo-banner" role="note"><span class="badge badge--solid">{t('demo.badge')}</span> {copy.banner}</p>
    </div>
  </section>

  <div class="container">
    <section class="login" data-login aria-labelledby="login-title">
      <h1 id="login-title">{copy.loginTitle}</h1>
      <noscript><p>{copy.noscript}</p></noscript>
      <form class="form" data-login-form>
        <div class="field">
          <label for="m-user">{copy.username}</label>
          <input id="m-user" name="username" type="text" autocomplete="off" />
        </div>
        <div class="field">
          <label for="m-pass">{copy.password}</label>
          <input id="m-pass" name="password" type="password" autocomplete="off" />
        </div>
        <div><button class="button" type="submit">{copy.login}</button></div>
      </form>
    </section>
  </div>

  <div class="dashboard" data-members hidden>
    <section class="hello">
      <div class="container hello-inner">
        <div>
          <h1 tabindex="-1" data-members-heading>{copy.hello}</h1>
          <p class="profile">{copy.profile}</p>
          <p class="profile-note">{copy.profileNote}</p>
        </div>
        <button class="button button--on-dark" type="button" data-logout>{copy.logout}</button>
      </div>
    </section>

    <div class="container panels">
      <section class="card card--outline" aria-labelledby="week-title">
        <h2 id="week-title">{copy.weekTitle}</h2>
        <ul class="plain-list rows">
          {
            week.map((s) => (
              <li>
                <span class="row-key">{t(`day.${s.data.day}`)}</span>
                <span>
                  <strong>{s.data.time}</strong>
                  <span class="muted"> · {s.data.location}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="card card--outline" aria-labelledby="matches-title">
        <h2 id="matches-title">{copy.matchesTitle}</h2>
        <ul class="plain-list rows">
          {
            copy.matches.map((m) => (
              <li>
                <span class="row-key">{m.date}</span>
                <span>
                  <strong>{m.name}</strong>
                  <br />
                  <span class="muted">{m.note}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="card card--outline" aria-labelledby="arrange-title">
        <h2 id="arrange-title">{copy.arrangeTitle}</h2>
        <ul class="plain-list arrange">
          {copy.arrange.map((a) => <li><button class="button button--ghost" type="button">{a}</button></li>)}
        </ul>
        <p class="small muted">{copy.arrangeNote}</p>
      </section>

      <section class="card card--outline" aria-labelledby="support-title">
        <h2 id="support-title">{copy.supportTitle}</h2>
        {
          copy.support.map((s) => (
            <div class="support">
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
            </div>
          ))
        }
      </section>
    </div>

    <section class="section section--tint" aria-labelledby="prices-title">
      <div class="container">
        <div class="section-intro">
          <h2 id="prices-title">{copy.pricesTitle}</h2>
          <p>{copy.pricesText}</p>
        </div>
        <div class="grid">
          {memberships.map((m) => <MembershipCard item={m} lang={lang} forceShowPrice />)}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="docs-title">
      <div class="container">
        <h2 id="docs-title">{copy.docsTitle}</h2>
        <ul class="plain-list docs">
          {
            copy.docs.map((d) => (
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                  <path d="M14 3v5h5" />
                </svg>
                {d} <span class="muted">{copy.sample}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>
</Base>

<script>
  // Nep-login: er wordt niets gecontroleerd, opgeslagen of verstuurd.
  const login = document.querySelector<HTMLElement>('[data-login]');
  const form = document.querySelector<HTMLFormElement>('[data-login-form]');
  const area = document.querySelector<HTMLElement>('[data-members]');
  const heading = document.querySelector<HTMLElement>('[data-members-heading]');
  const logout = document.querySelector<HTMLButtonElement>('[data-logout]');
  if (login && form && area && logout) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.reset();
      login.hidden = true;
      area.hidden = false;
      heading?.focus();
    });
    logout.addEventListener('click', () => {
      area.hidden = true;
      login.hidden = false;
      form.querySelector('input')?.focus();
    });
  }
</script>

<style>
  .top {
    padding-top: var(--space-5);
  }
  .demo-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-4) var(--space-5);
    background: var(--color-accent-tint);
    color: var(--color-accent-text);
    border-radius: var(--radius-lg);
    font-weight: 600;
    margin: 0;
  }
  .login {
    max-width: 26rem;
    padding-block: var(--space-7) var(--space-8);
  }
  .login h1 {
    font-size: var(--text-2xl);
  }
  .login[hidden],
  .dashboard[hidden] {
    display: none;
  }
  .hello {
    background: var(--color-brand);
    color: var(--color-on-brand);
    margin-top: var(--space-5);
  }
  .hello-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-7);
  }
  .hello h1 {
    margin-bottom: var(--space-2);
  }
  .hello h1:focus {
    outline: none;
  }
  .profile {
    margin: 0;
    color: var(--color-on-brand-muted);
    font-weight: 600;
  }
  .profile-note {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    color: var(--color-on-brand-soft);
  }
  .panels {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    padding-block: var(--space-7);
  }
  .panels h2 {
    font-size: var(--text-xl);
  }
  .rows li {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-border);
    font-size: 1rem;
  }
  .row-key {
    font-weight: 700;
    color: var(--color-brand-mid);
  }
  .arrange {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .arrange .button {
    min-height: 2.75rem;
    font-size: var(--text-sm);
  }
  .small {
    font-size: var(--text-sm);
  }
  .support + .support {
    margin-top: var(--space-4);
  }
  .support h3 {
    font-size: 1.0625rem;
    margin-bottom: var(--space-1);
  }
  .docs {
    display: grid;
    gap: var(--space-2);
    max-width: 40rem;
  }
  .docs li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-brand-tint);
    border-radius: var(--radius);
    font-weight: 600;
  }
  .docs svg {
    color: var(--color-brand-mid);
    flex: none;
  }
</style>
