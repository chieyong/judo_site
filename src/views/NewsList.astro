---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import NewsCard from '../components/NewsCard.astro';
import { getLocalized, useTranslations } from '../i18n/utils';
import { routes, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const lead = {
  nl: 'Nieuws over trainingen, stagedagen, wedstrijden en de partnerclubs.',
  en: 'News about training, camp days, competitions and the partner clubs.',
}[lang];

const news = (await getLocalized('nieuws', lang)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base lang={lang} title={t('nav.news')} description={lead} alternates={routes.news}>
  <PageHero title={t('nav.news')} lead={lead} />
  <section class="section">
    <div class="container">
      <div class="grid news">
        {news.map((item) => <NewsCard item={item} lang={lang} headingLevel="h2" />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .news {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-7) var(--space-5);
  }
</style>
