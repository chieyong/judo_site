---
import Base from '../layouts/Base.astro';
import MembershipCard from '../components/MembershipCard.astro';
import Schedule from '../components/Schedule.astro';
import { getLocalized, useTranslations } from '../i18n/utils';
import { path, routes, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
  nl: {
    title: 'Voor ouders',
    description: 'Hoe werkt het talenttraject, past het bij uw kind, en wat houdt een lidmaatschap in?',
    lead: 'Uw kind blijft lid van de eigen judoclub. Bij ons komt er extra training en begeleiding bij. Hieronder leest u hoe dat werkt.',
    stepsTitle: 'Het traject in vier stappen',
    steps: [
      { title: 'Club', text: 'Uw kind traint bij een van onze partnerclubs en heeft plezier in judo.' },
      { title: 'Trainer', text: 'De trainer ziet talent en bespreekt met u of extra training past.' },
      { title: 'Stage en selectie', text: 'Uw kind doet mee aan een kennismakingstraining of stagedag. Daarna volgt een gesprek.' },
      { title: 'Instroom', text: 'Uw kind start in een talentgroep die past bij leeftijd en niveau.' },
    ],
    checkTitle: 'Past dit bij mijn kind?',
    checkIntro: 'Herkent u een paar van deze punten? Dan is het de moeite waard om met de trainer te praten.',
    checklist: [
      'Mijn kind gaat met plezier naar judo en wil vaak meer trainen.',
      'Mijn kind leert technieken snel en wil ze graag goed doen.',
      'Mijn kind kan tegen zijn of haar verlies en probeert het opnieuw.',
      'Ons gezin kan één tot drie extra trainingen per week inplannen.',
      'Mijn kind combineert judo graag met school en vrienden, zonder dat het te veel wordt.',
    ],
    checkNote: 'Uw antwoorden worden nergens opgeslagen. Het is alleen een hulpmiddel voor uzelf.',
    membershipTitle: 'Lidmaatschappen',
    membershipIntro: 'Er zijn drie vormen. Welke past, bespreekt u samen met de trainer.',
    scheduleTitle: 'Trainingsrooster',
    scheduleCaption: 'Trainingen van de talentgroepen',
    nextTitle: 'Volgende stap',
    nextText: 'Praat met de trainer van uw eigen club. Nog geen club? Bekijk onze partnerclubs.',
  },
  en: {
    title: 'For parents',
    description: 'How the talent pathway works, whether it suits your child, and what membership includes.',
    lead: 'Your child stays a member of their own judo club. With us they get extra training and guidance on top of that. Here is how it works.',
    stepsTitle: 'The pathway in four steps',
    steps: [
      { title: 'Club', text: 'Your child trains at one of our partner clubs and enjoys judo.' },
      { title: 'Coach', text: 'The coach spots talent and discusses with you whether extra training is a good fit.' },
      { title: 'Camp and selection', text: 'Your child joins an introductory session or camp day, followed by a conversation.' },
      { title: 'Joining', text: 'Your child starts in a talent group that fits their age and level.' },
    ],
    checkTitle: 'Is this right for my child?',
    checkIntro: 'Do you recognise a few of these? Then it is worth talking to the coach.',
    checklist: [
      'My child enjoys judo and often wants to train more.',
      'My child picks up techniques quickly and wants to get them right.',
      'My child copes with losing and tries again.',
      'Our family can fit in one to three extra sessions a week.',
      'My child likes to combine judo with school and friends without it becoming too much.',
    ],
    checkNote: 'Your answers are not stored anywhere. This is only a tool for yourself.',
    membershipTitle: 'Memberships',
    membershipIntro: 'There are three options. You decide together with the coach which one fits.',
    scheduleTitle: 'Training schedule',
    scheduleCaption: 'Talent group training sessions',
    nextTitle: 'Next step',
    nextText: 'Talk to the coach at your own club. No club yet? Have a look at our partner clubs.',
  },
}[lang];

const memberships = (await getLocalized('lidmaatschappen', lang)).sort((a, b) => a.data.order - b.data.order);
---

<Base lang={lang} title={copy.title} description={copy.description} alternates={routes.parents}>
  <div class="container page-header">
    <h1>{copy.title}</h1>
    <p class="lead">{copy.lead}</p>
  </div>

  <section class="section section--tint" aria-labelledby="steps-title">
    <div class="container">
      <h2 id="steps-title">{copy.stepsTitle}</h2>
      <ol class="steps">
        {
          copy.steps.map((s, i) => (
            <li class="step card">
              <span class="step-nr" aria-hidden="true">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="check-title">
    <div class="container">
      <h2 id="check-title">{copy.checkTitle}</h2>
      <p>{copy.checkIntro}</p>
      <fieldset class="checklist card">
        <legend class="visually-hidden">{copy.checkTitle}</legend>
        {
          copy.checklist.map((line, i) => (
            <div class="check">
              <input type="checkbox" id={`check-${i}`} />
              <label for={`check-${i}`}>{line}</label>
            </div>
          ))
        }
      </fieldset>
      <p class="hint">{copy.checkNote}</p>
    </div>
  </section>

  <section class="section section--accent" aria-labelledby="membership-title">
    <div class="container">
      <h2 id="membership-title">{copy.membershipTitle}</h2>
      <p>{copy.membershipIntro}</p>
      <div class="grid">
        {memberships.map((m) => <MembershipCard item={m} lang={lang} />)}
      </div>
      <p class="price-notice">{t('price.notice')}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="schedule-title">
    <div class="container">
      <h2 id="schedule-title">{copy.scheduleTitle}</h2>
      <Schedule lang={lang} caption={copy.scheduleCaption} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{copy.nextTitle}</h2>
      <p>{copy.nextText}</p>
      <p class="actions">
        <a class="button" href={path('clubs', lang)}>{t('nav.clubs')}</a>
        <a class="button button--ghost" href={path('whyJudo', lang)}>{t('nav.whyJudo')}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    counter-reset: none;
  }
  .step {
    position: relative;
    padding-top: var(--space-6);
  }
  .step-nr {
    position: absolute;
    top: calc(-1 * var(--space-4));
    left: var(--space-5);
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-brand);
    color: #fff;
    font-weight: 700;
  }
  .steps {
    padding-top: var(--space-4);
  }
  .step h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }
  .step p {
    margin: 0;
  }
  .checklist {
    max-width: 42rem;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .check {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .check input {
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 0.2rem;
    accent-color: var(--color-brand);
    flex: none;
  }
  .hint {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-3);
  }
  .price-notice {
    margin-top: var(--space-5);
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius);
    max-width: 48rem;
    font-weight: 600;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
