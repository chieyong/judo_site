---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import MembershipCard from '../components/MembershipCard.astro';
import Schedule from '../components/Schedule.astro';
import { getLocalized, useTranslations } from '../i18n/utils';
import { path, routes, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const copy = {
  nl: {
    title: 'Talent op de mat? Geef het meer uitdaging.',
    pageTitle: 'Talentprogramma',
    description: 'Hoe werkt het talenttraject, past het bij uw kind, en wat houdt een lidmaatschap in?',
    eyebrow: 'Talentprogramma · voor ouders van een talentvolle judoka',
    lead: 'Top Judo Lindeweerd geeft talentvolle judoka’s uit de regio extra trainingen, kampen en wedstrijdcoaching. Naast hun eigen club, niet in plaats van.',
    ctaSteps: 'Zo werkt het',
    ctaClubs: 'Vind een club',
    fitTitle: 'Past dit bij mijn kind?',
    fitIntro:
      'Het talentprogramma is bedoeld voor judoka’s die meer uitdaging nodig hebben dan hun club kan bieden. Niet iedereen kan instromen. Zo houden we het niveau hoog, en blijft de club de plek voor de basis.',
    fitSignals: [
      { title: 'Plezier en inzet', text: 'Gaat graag naar judo en wil vaak méér trainen.' },
      { title: 'Leert snel', text: 'Pikt technieken snel op en wil ze goed doen.' },
      { title: 'Wil winnen', text: 'Vindt wedstrijden leuk en kan tegen verlies.' },
      { title: 'Tijd en steun', text: 'Het gezin kan twee tot vier trainingen per week inplannen.' },
    ],
    fitProposal: 'Deze vier signalen worden nog bevestigd door de technische staf.',
    fitNext: 'Herkent u uw kind in de meeste punten? Bespreek het dan eerst met de clubtrainer. Die kent uw kind het best.',
    stepsTitle: 'Zo werkt het',
    stepsIntro: 'Meestal draagt de clubtrainer een talent voor. U mag als ouder ook zelf het initiatief nemen, maar de clubtrainer is er altijd bij.',
    steps: [
      { title: 'Judo bij je club', text: 'De basis blijft de eigen club. Daar train je, en daar haal je je banden.' },
      { title: 'Overleg met je clubtrainer', text: 'De trainer draagt je voor, of jullie vragen samen een proeftraining aan.' },
      { title: 'Proeftraining', text: 'Je traint een paar keer mee. Onder 13? Je mag ook eerst gratis meetrainen op donderdag.' },
      { title: 'Ja, of nog niet', text: 'Ja: je traint voortaan bij ons én je club. Nog niet: je krijgt advies en mag later opnieuw komen.' },
    ],
    moreTitle: 'Meer dan alleen judo',
    moreIntro: 'Een talent groeit niet alleen op de mat. Daarom bouwen we aan vier dingen tegelijk.',
    more: [
      { title: 'Judo', text: 'Techniek, randori en wedstrijdtraining. Tot vier keer per week, afhankelijk van de leeftijd.' },
      { title: 'Kracht', text: 'Een individueel krachttraject onder begeleiding, op uitnodiging van de technische staf.' },
      { title: 'Conditie', text: 'Loop- en bootcamptrainingen in het park, en een eigen trainingskamp in de zomer.' },
      { title: 'Begeleiding', text: 'Aandacht voor voeding, mentale gezondheid en een vertrouwenscontactpersoon.' },
    ],
    membershipTitle: 'Lidmaatschap',
    membershipIntro: 'Na de proeftraining kiest u samen met de trainer: aspirant of meteen volledig lid. Het verschil zit in wedstrijdcoaching en trainingskampen.',
    clubFee: 'Het lidmaatschap van de eigen club loopt gewoon door en betaalt u daar.',
    scheduleTitle: 'Trainingsweek',
    scheduleIntro: 'Wat uw kind traint, hangt af van de leeftijd. Wijzigingen staan in de ledenomgeving.',
    scheduleCaption: 'Trainingen per leeftijdsgroep en dag',
    faqTitle: 'Vragen van ouders',
    faq: [
      { q: 'Blijft mijn kind lid van de eigen club?', a: 'Ja, dat is verplicht. Banden haal je alleen bij je eigen club, en daar blijf je ook trainen.' },
      { q: 'Voor wie doet mijn kind mee aan wedstrijden?', a: 'Voor de eigen club. In onze berichten noemen we de judoka altijd met de club erbij.' },
      { q: 'Hoeveel tijd kost het?', a: 'Twee tot vier trainingen per week bij ons, naast de training bij de club. In het gesprek kijken we wat haalbaar is naast school.' },
      { q: 'En als mijn kind (nog) niet wordt aangenomen?', a: 'Dan krijgt u advies over wat uw kind kan oefenen. Over een half jaar mag uw kind opnieuw een proeftraining doen.' },
    ],
    finalTitle: 'Klaar voor de volgende stap?',
    finalText: 'Praat met de trainer van de eigen club. Nog geen club? Bekijk onze partnerclubs.',
  },
  en: {
    title: 'Talent on the mat? Give it more of a challenge.',
    pageTitle: 'Talent programme',
    description: 'How the talent pathway works, whether it suits your child, and what membership includes.',
    eyebrow: 'Talent programme · for parents of a talented judoka',
    lead: 'Top Judo Lindeweerd gives talented judoka from the region extra training, camps and competition coaching. Alongside their own club, not instead of it.',
    ctaSteps: 'How it works',
    ctaClubs: 'Find a club',
    fitTitle: 'Is this right for my child?',
    fitIntro:
      'The talent programme is for judoka who need more of a challenge than their club can offer. Not everyone can join. That keeps the level high, and the club remains the place for the basics.',
    fitSignals: [
      { title: 'Enjoyment and effort', text: 'Loves judo and often wants to train more.' },
      { title: 'Learns quickly', text: 'Picks up techniques fast and wants to get them right.' },
      { title: 'Wants to win', text: 'Enjoys competitions and copes with losing.' },
      { title: 'Time and support', text: 'The family can fit in two to four sessions a week.' },
    ],
    fitProposal: 'These four signals are still to be confirmed by the technical staff.',
    fitNext: 'Do you recognise your child in most of these? Talk to the club coach first. They know your child best.',
    stepsTitle: 'How it works',
    stepsIntro: 'Usually the club coach nominates a talent. As a parent you can also take the initiative, but the club coach is always involved.',
    steps: [
      { title: 'Judo at your club', text: 'Your own club stays the base. That is where you train and earn your belts.' },
      { title: 'Talk to your club coach', text: 'The coach nominates you, or you request a trial session together.' },
      { title: 'Trial session', text: 'You join a few sessions. Under 13? You can also first train along for free on Thursday.' },
      { title: 'Yes, or not yet', text: 'Yes: you now train with us and at your club. Not yet: you get advice and can try again later.' },
    ],
    moreTitle: 'More than just judo',
    moreIntro: 'Talent does not only grow on the mat. That is why we work on four things at once.',
    more: [
      { title: 'Judo', text: 'Technique, randori and competition training. Up to four times a week, depending on age.' },
      { title: 'Strength', text: 'An individual, supervised strength programme, by invitation of the technical staff.' },
      { title: 'Fitness', text: 'Running and bootcamp sessions in the park, and our own summer training camp.' },
      { title: 'Support', text: 'Attention to nutrition, mental health and a confidential contact person.' },
    ],
    membershipTitle: 'Membership',
    membershipIntro: 'After the trial session you choose together with the coach: aspirant or straight to full member. The difference is competition coaching and training camps.',
    clubFee: 'Membership of your own club continues as usual and is paid there.',
    scheduleTitle: 'Training week',
    scheduleIntro: 'What your child trains depends on their age. Changes are posted in the members area.',
    scheduleCaption: 'Training sessions by age group and day',
    faqTitle: 'Questions from parents',
    faq: [
      { q: 'Does my child stay a member of their own club?', a: 'Yes, that is required. Belts are only awarded at your own club, and you keep training there too.' },
      { q: 'Who does my child compete for?', a: 'For their own club. In our news we always mention the judoka together with their club.' },
      { q: 'How much time does it take?', a: 'Two to four sessions a week with us, on top of club training. We discuss what is feasible alongside school.' },
      { q: 'What if my child is not (yet) accepted?', a: 'You get advice on what your child can work on. After six months your child can do another trial session.' },
    ],
    finalTitle: 'Ready for the next step?',
    finalText: 'Talk to the coach at your own club. No club yet? Have a look at our partner clubs.',
  },
}[lang];

// Iconen voor judo, kracht, conditie en begeleiding
const pillarIcons = [
  '<circle cx="12" cy="5" r="2.5"></circle><path d="M5 21l4-8 3 2 3-2 4 8M8 11l4-3 4 3"></path>',
  '<path d="M6 8v8M18 8v8M3 10v4M21 10v4M6 12h12"></path>',
  '<path d="M3 12h4l3-7 4 14 3-7h4"></path>',
  '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path>',
];

const memberships = (await getLocalized('lidmaatschappen', lang)).sort((a, b) => a.data.order - b.data.order);
---

<Base lang={lang} title={copy.pageTitle} description={copy.description} alternates={routes.talent}>
  <PageHero eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead}>
    <Fragment slot="actions">
      <a class="button button--accent" href="#zo-werkt-het">{copy.ctaSteps}</a>
      <a class="button button--on-dark" href={path('clubs', lang)}>{copy.ctaClubs}</a>
    </Fragment>
  </PageHero>

  <section class="section" aria-labelledby="fit-title">
    <div class="container split">
      <div>
        <h2 id="fit-title">{copy.fitTitle}</h2>
        <p class="muted">{copy.fitIntro}</p>
        <p class="fit-next">{copy.fitNext}</p>
      </div>
      <div>
        <ul class="plain-list checklist">
          {
            copy.fitSignals.map((s) => (
              <li>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="M5 12.5l4.5 4.5L19 7.5" />
                </svg>
                <span>
                  <strong>{s.title}</strong>
                  <span class="muted"> {s.text}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <p class="note"><span class="proposal">{t('proposal')}</span> {copy.fitProposal}</p>
      </div>
    </div>
  </section>

  <section class="section section--tint" id="zo-werkt-het" aria-labelledby="steps-title">
    <div class="container">
      <div class="section-intro">
        <h2 id="steps-title">{copy.stepsTitle}</h2>
        <p>{copy.stepsIntro}</p>
      </div>
      <ol class="plain-list timeline">
        {
          copy.steps.map((s, i) => (
            <li>
              <span class:list={['step-nr', { 'step-nr--accent': i === copy.steps.length - 1 }]} aria-hidden="true">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="more-title">
    <div class="container split">
      <div>
        <h2 id="more-title">{copy.moreTitle}</h2>
        <p class="muted">{copy.moreIntro}</p>
      </div>
      <dl class="pillars">
        {
          copy.more.map((m, i) => (
            <div>
              <dt>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={pillarIcons[i]} />
                {m.title}
              </dt>
              <dd>{m.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="membership-title">
    <div class="container">
      <div class="section-intro">
        <h2 id="membership-title">{copy.membershipTitle}</h2>
        <p>{copy.membershipIntro}</p>
      </div>
      <div class="grid">
        {memberships.map((m) => <MembershipCard item={m} lang={lang} />)}
      </div>
      <div class="price-notice">
        <p><strong>{t('price.notice')}</strong></p>
        <p>{copy.clubFee}</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="schedule-title">
    <div class="container">
      <div class="section-intro">
        <h2 id="schedule-title">{copy.scheduleTitle}</h2>
        <p>{copy.scheduleIntro}</p>
      </div>
      <Schedule lang={lang} caption={copy.scheduleCaption} />
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="faq-title">
    <div class="container">
      <h2 id="faq-title">{copy.faqTitle}</h2>
      <div class="faq">
        {
          copy.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div>
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section final">
    <div class="container">
      <h2>{copy.finalTitle}</h2>
      <p>{copy.finalText}</p>
      <div class="actions">
        <a class="button button--accent" href={path('clubs', lang)}>{t('nav.clubs')}</a>
        <a class="button button--ghost" href={path('start', lang)}>{t('nav.start')}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .split {
    display: grid;
    gap: var(--space-6) var(--space-8);
  }
  .fit-next {
    font-weight: 600;
    margin: 0;
  }
  .checklist li {
    display: flex;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .checklist li:first-child {
    padding-top: 0;
  }
  .checklist svg {
    color: var(--color-brand-mid);
    flex: none;
    margin-top: 0.125rem;
  }
  .note {
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  /* Stappen als tijdlijn: verticaal op mobiel, horizontaal op breed scherm */
  .timeline {
    display: grid;
    gap: var(--space-5);
    position: relative;
  }
  .timeline li {
    position: relative;
    padding-left: 3.5rem;
  }
  .timeline .step-nr {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    z-index: 1;
  }
  .timeline li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 1.25rem;
    top: 2.5rem;
    bottom: calc(-1 * var(--space-5));
    width: 2px;
    background: #b7c2d6;
  }
  .timeline h3 {
    font-size: var(--text-lg);
    margin: 0.375rem 0 var(--space-2);
  }
  .timeline p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
  }
  .pillars {
    display: grid;
    gap: var(--space-5) var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    margin: 0;
  }
  .pillars dt {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    font-size: var(--text-lg);
    padding-bottom: var(--space-2);
    border-bottom: 3px solid var(--color-accent);
    margin-bottom: var(--space-2);
  }
  .pillars dt svg {
    color: var(--color-brand-mid);
  }
  .pillars dd {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
  }
  @media (min-width: 56rem) {
    .split {
      grid-template-columns: 2fr 3fr;
    }
    .timeline {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-5);
    }
    .timeline li {
      padding-left: 0;
      padding-top: 3.5rem;
    }
    .timeline li:not(:last-child)::before {
      left: 2.5rem;
      right: calc(-1 * var(--space-5));
      top: 1.25rem;
      bottom: auto;
      width: auto;
      height: 2px;
    }
  }
  .price-notice {
    margin-top: var(--space-6);
    padding: var(--space-5) var(--space-6);
    background: var(--color-accent-tint);
    color: var(--color-accent-text);
    border-radius: var(--radius-lg);
    max-width: 48rem;
  }
  .price-notice p:last-child {
    margin: 0;
  }
  .final {
    text-align: center;
  }
  .final p {
    color: var(--color-text-muted);
  }
  .final .actions {
    justify-content: center;
  }
</style>
