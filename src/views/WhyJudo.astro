---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { path, routes, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  nl: {
    title: 'Waarom judo?',
    description: 'Wat judo een kind geeft, en waarom het een goede tweede sport is.',
    eyebrow: 'Lindeweerd, judostad aan de rivier',
    lead: 'Je leert vallen, opstaan en de ander respecteren. Judo maakt kinderen sterk, op de mat en daarbuiten.',
    givesTitle: 'Wat judo een kind geeft',
    gives: [
      { title: 'Veilig leren vallen', text: 'Valbreken is het eerste wat je leert. Handig op de mat, op het voetbalveld en op de fiets.' },
      { title: 'Zelfvertrouwen', text: 'Je leert je eigen kracht kennen, en wat je kunt als het spannend wordt.' },
      { title: 'Respect en regels', text: 'Groeten voor en na elke partij. Winnen en verliezen doe je met respect.' },
      { title: 'Een sterk lijf', text: 'Kracht, balans en lenigheid. Je hele lichaam doet mee.' },
      { title: 'Stoeien met spelregels', text: 'Geen slaan en geen schoppen. Kinderen mogen hun energie kwijt, veilig en met toezicht.' },
      { title: 'Elke stap zichtbaar', text: 'Met elke nieuwe band zie je dat je beter wordt. Dat motiveert.' },
    ],
    secondTitle: 'De ideale tweede sport',
    secondText:
      'Veel judoka’s doen ook aan voetbal, hockey of een andere teamsport. Dat past goed: judo traint juist wat je daar ook nodig hebt. Balans, valtechniek en duelkracht, en het hele jaar door binnen.',
    secondPoints: ['Minder blessures door goed leren vallen', 'Sterker in duels door balans en rompkracht', 'Een binnensport voor de wintermaanden'],
    faqTitle: 'Vragen van ouders',
    faq: [
      { q: 'Is judo niet gevaarlijk?', a: 'Je leert eerst vallen, je traint op zachte matten en een trainer let op. Slaan en schoppen horen er niet bij.' },
      { q: 'Vanaf welke leeftijd?', a: 'Bij sommige clubs al vanaf 4 jaar. Kijk bij de club in de buurt wat zij aanbieden.' },
      { q: 'Wat heb ik nodig?', a: 'Voor een proefles is sportkleding genoeg. Een judopak koop je pas als je blijft, eventueel tweedehands.' },
    ],
    tryTitle: 'Probeer het gewoon',
    tryText: 'Er zijn zes judoclubs in de regio die samenwerken met Top Judo Lindeweerd. Er zit er vast een bij jou in de buurt.',
    tryCta: 'Vind een club',
    tryParents: 'Mijn kind heeft talent',
  },
  en: {
    title: 'Why judo?',
    description: 'What judo gives a child, and why it is a great second sport.',
    eyebrow: 'Lindeweerd, judo town on the river',
    lead: 'You learn to fall, get back up and respect others. Judo makes children strong, on the mat and off it.',
    givesTitle: 'What judo gives a child',
    gives: [
      { title: 'Falling safely', text: 'Breakfalls are the first thing you learn. Useful on the mat, on the football pitch and on your bike.' },
      { title: 'Confidence', text: 'You get to know your own strength, and what you can do when things get exciting.' },
      { title: 'Respect and rules', text: 'Bowing before and after every bout. You win and lose with respect.' },
      { title: 'A strong body', text: 'Strength, balance and flexibility. Your whole body takes part.' },
      { title: 'Wrestling with rules', text: 'No hitting and no kicking. Children can burn off energy, safely and supervised.' },
      { title: 'Every step visible', text: 'With every new belt you can see yourself improve. That is motivating.' },
    ],
    secondTitle: 'The ideal second sport',
    secondText:
      'Many judoka also play football, hockey or another team sport. That works well: judo trains exactly what you need there too. Balance, falling technique and strength in duels, and all year round indoors.',
    secondPoints: ['Fewer injuries thanks to good breakfalls', 'Stronger in duels through balance and core strength', 'An indoor sport for the winter months'],
    faqTitle: 'Questions from parents',
    faq: [
      { q: 'Isn’t judo dangerous?', a: 'You learn to fall first, you train on soft mats and a coach keeps an eye on things. Hitting and kicking are not part of it.' },
      { q: 'From what age?', a: 'Some clubs start from age 4. Check what the club near you offers.' },
      { q: 'What do I need?', a: 'Sports clothes are enough for a trial lesson. You only buy a judo suit if you stay, second-hand if you like.' },
    ],
    tryTitle: 'Just give it a try',
    tryText: 'There are six judo clubs in the region working with Top Judo Lindeweerd. There is bound to be one near you.',
    tryCta: 'Find a club',
    tryParents: 'My child has talent',
  },
}[lang];
---

<Base lang={lang} title={copy.title} description={copy.description} alternates={routes.whyJudo}>
  <PageHero eyebrow={copy.eyebrow} title={copy.title} lead={copy.lead} />

  <section class="section" aria-labelledby="gives-title">
    <div class="container">
      <h2 id="gives-title">{copy.givesTitle}</h2>
      <ul class="plain-list grid">
        {
          copy.gives.map((g) => (
            <li class="card">
              <h3>{g.title}</h3>
              <p>{g.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="second-title">
    <div class="container second">
      <div>
        <h2 id="second-title">{copy.secondTitle}</h2>
        <p class="muted">{copy.secondText}</p>
      </div>
      <ul class="plain-list points">
        {
          copy.secondPoints.map((p) => (
            <li>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M5 12.5l4.5 4.5L19 7.5" />
              </svg>
              {p}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <h2 id="faq-title">{copy.faqTitle}</h2>
      <div class="faq">
        {
          copy.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div>
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="try" aria-labelledby="try-title">
    <div class="container inner">
      <h2 id="try-title">{copy.tryTitle}</h2>
      <p>{copy.tryText}</p>
      <div class="actions">
        <a class="button button--accent" href={path('clubs', lang)}>{copy.tryCta}</a>
        <a class="button button--on-dark" href={path('parents', lang)}>{copy.tryParents}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .second {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .points {
    display: grid;
    gap: var(--space-3);
  }
  .points li {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    font-weight: 600;
  }
  .points svg {
    color: var(--color-brand-mid);
    flex: none;
  }
  .try {
    background: var(--color-brand);
    color: var(--color-on-brand);
  }
  .try .inner {
    padding-block: var(--space-8);
  }
  .try p {
    color: var(--color-on-brand-muted);
    max-width: 40rem;
    margin-bottom: var(--space-5);
  }
  @media (min-width: 48rem) {
    .second {
      grid-template-columns: 3fr 2fr;
    }
  }
</style>
